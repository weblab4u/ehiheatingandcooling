ErrorDocument 404 /404.html
Options -Indexes
# Static files cache for a year (CSS is inlined and main.js carries a ?v= version, so changes still reach visitors)
AddType font/woff2 .woff2
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(webp|png|jpe?g|svg|woff2|css|js)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
</IfModule>
RewriteEngine On
# One address: https://efficienthomeimprovements.ca (the temporary Hostinger address is left alone)
RewriteCond %{HTTP_HOST} ^www\.efficienthomeimprovements\.ca$ [NC]
RewriteRule ^(.*)$ https://efficienthomeimprovements.ca/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^efficienthomeimprovements\.ca$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://efficienthomeimprovements.ca/$1 [R=301,L]
# Old site URLs
RewriteRule ^about-us/?$ /about-ehi/ [NC,L,R=301]
RewriteRule ^contact-us-1/?$ /contact/ [NC,L,R=301]
RewriteRule ^rebates/?$ /heat-pump-rebates/ [NC,L,R=301]
RewriteRule ^payment-plans/?$ /financing/ [NC,L,R=301]
RewriteRule ^tankless-water-heaters/?$ /water-heater/ [NC,L,R=301]
RewriteRule ^heating-\&-cooling/?$ /services/ [NC,L,R=301]
RewriteRule ^commercial/?$ / [NC,L,R=301]
RewriteRule ^luxury-doors-\&-windows/?$ / [NC,L,R=301]
RewriteRule ^home-renovations/?$ / [NC,L,R=301]
RewriteRule ^custom-design-decks/?$ / [NC,L,R=301]
RewriteRule ^insulation/air-sealing/?$ / [NC,L,R=301]
